---
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);

// One source of truth: the visible <details> list and the FAQPage JSON-LD are both
// rendered from this array, so the structured data always matches the on-page text
// verbatim. Native <details> keeps the answers in the static HTML (collapsed, not
// JS-injected), so crawlers and AI models can read and cite them.
const faqs: { q: string; a: string }[] = t('faq.items');

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<!-- ════════════════════════════════════════════════════
     COMPONENT: Faq.astro
     ════════════════════════════════════════════════════ -->
<section class="section" id="faq" style="padding-top:0">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{t('faq.eyebrow')}</p>
      <h2>{t('faq.headline')}</h2>
    </div>
    <div class="faq-list reveal">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
