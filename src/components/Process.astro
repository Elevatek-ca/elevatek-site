---
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
---
<!-- ════════════════════════════════════════════════════
     COMPONENT: Process.astro
     ════════════════════════════════════════════════════ -->
<section class="section process" id="process">
  <div class="wrap on-dark">
    <div class="section-head reveal">
      <p class="eyebrow">{t('process.eyebrow')}</p>
      <h2>{t('process.headline')}</h2>
      <p class="lead">{t('process.lead')}</p>
    </div>
    <div class="steps">
      <article class="step reveal">
        <h3>{t('process.step1.title')}</h3>
        <p>{t('process.step1.body')}</p>
        <div class="mini" aria-hidden="true">
          <div class="mini-row"><em>{t('process.step1.miniData')}</em><div class="bar"><i style="--w:46%;--c:var(--warn)"></i></div></div>
          <div class="mini-row"><em>{t('process.step1.miniFlows')}</em><div class="bar"><i style="--w:72%;--c:#6E89FF"></i></div></div>
          <div class="mini-row"><em>{t('process.step1.miniOwners')}</em><div class="bar"><i style="--w:31%;--c:var(--warn)"></i></div></div>
        </div>
      </article>
      <article class="step reveal">
        <h3>{t('process.step2.title')}</h3>
        <p>{t('process.step2.body')}</p>
        <div class="mini" aria-hidden="true">
          <div class="mini-row"><em>{t('process.step2.miniNow')}</em><div class="bar"><i style="--w:38%;--c:#6E89FF"></i></div></div>
          <div class="mini-row"><em>{t('process.step2.miniNext')}</em><div class="bar"><i class="off" style="--x:20%;--w:42%;--c:#4A63D6"></i></div></div>
          <div class="mini-row"><em>{t('process.step2.miniLater')}</em><div class="bar"><i class="off" style="--x:46%;--w:48%;--c:#2F3D74"></i></div></div>
        </div>
      </article>
      <article class="step reveal">
        <h3>{t('process.step3.title')}</h3>
        <p>{t('process.step3.body')}</p>
        <div class="mini-weeks" aria-hidden="true">
          <span class="wk done">w1</span>
          <span class="wk done">w2</span>
          <span class="wk done">w3</span>
          <span class="wk now">w4</span>
        </div>
      </article>
    </div>
  </div>
</section>
