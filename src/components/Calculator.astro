---
import { useTranslations, localizePath } from '../i18n/utils';
const lang = Astro.currentLocale;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
const M = t('calculator.js');
---
<!-- ════════════════════════════════════════════════════
     COMPONENT: Calculator.astro
     User-supplied inputs, visible arithmetic. No claims
     about Elevatek's impact — by design.
     ════════════════════════════════════════════════════ -->
<section class="section" id="cost" style="padding-top:0">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{t('calculator.eyebrow')}</p>
      <h2>{t('calculator.headline')}</h2>
      <p class="lead">{t('calculator.lead')}</p>
    </div>
    <div class="calc reveal">
      <div class="widget-head">
        <span class="widget-label">{t('calculator.widgetLabel')}</span>
        <span class="badge-you">{t('calculator.badge')}</span>
      </div>
      <div class="crow">
        <label for="c-people">{t('calculator.peopleLabel')} <output id="o-people">3</output></label>
        <input type="range" id="c-people" min="1" max="15" value="3">
      </div>
      <div class="crow">
        <label for="c-hours">{t('calculator.hoursLabel')} <output id="o-hours">4</output></label>
        <input type="range" id="c-hours" min="1" max="20" value="4">
      </div>
      <div class="crow">
        <label for="c-rate">{t('calculator.rateLabel')} <output id="o-rate">$85</output></label>
        <input type="range" id="c-rate" min="40" max="250" step="5" value="85">
      </div>
      <div class="ctotal" aria-live="polite">
        <b id="c-total">$48,960</b>
        <span>{t('calculator.totalSuffix')}</span>
      </div>
      <p class="cmath" id="c-math">{t('calculator.mathInitial')}</p>
      <p class="wnote">{t('calculator.wnote')}</p>
      <a class="btn btn-light" href={lp('/contact?type=session')}>{t('calculator.cta')}</a>
    </div>
  </div>
</section>

<script define:vars={{ M }}>
// Reconciliation-cost calculator
const cp = document.getElementById('c-people');
const ch = document.getElementById('c-hours');
const cr = document.getElementById('c-rate');
if (cp && ch && cr) {
  const recalc = () => {
    const p = +cp.value, h = +ch.value, r = +cr.value;
    document.getElementById('o-people').textContent = p;
    document.getElementById('o-hours').textContent = h;
    document.getElementById('o-rate').textContent = M.currency + r;
    const total = p * h * r * 48;
    document.getElementById('c-total').textContent = M.currency + total.toLocaleString(M.numberLocale);
    document.getElementById('c-math').textContent =
      p + (p === 1 ? M.person1 : M.personN) + M.mid + h + M.hours + r + M.weeks;
  };
  [cp, ch, cr].forEach(el => el.addEventListener('input', recalc));
}
</script>
