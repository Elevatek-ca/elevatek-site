---
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
const items = t('testimonials.items');
const liTitle = t('testimonials.liTitle');
---
<!-- ════════════════════════════════════════════════════
     COMPONENT: Testimonials.astro
     Quotes are verbatim LinkedIn recommendations. Each quote
     stays in its original language (some are French) and must
     never be translated — see testimonials._doNotTranslate in
     the locale JSON. Add profile URLs to each .li-mark when ready.
     ════════════════════════════════════════════════════ -->
<section class="section" id="clients" style="padding-top:0">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{t('testimonials.eyebrow')}</p>
      <h2>{t('testimonials.headline')}</h2>
      <p class="lead">{t('testimonials.lead')}</p>
    </div>
    <div class="quotes">
      {items.map((q: { name: string; img: string; quote: string; lang?: string }) => (
        <article class="quote reveal">
          <div class="quote-head">
            <span class="quote-name"><span class="avatar"><img src={q.img} alt="" width="36" height="36"></span>{q.name}</span>
            <span class="li-mark" title={liTitle}>in</span>
          </div>
          <p lang={q.lang}>{q.quote}</p>
        </article>
      ))}
    </div>
  </div>
</section>
