---
import { useTranslations } from '../i18n/utils';
const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);
// Localized slug, so it can't go through localizePath().
const implHref = lang === 'fr' ? '/fr/implantation-salesforce' : '/salesforce-implementation';
const s1chips = t('features.s1.chips');
const s1rows = t('features.s1.rows');
const s2chips = t('features.s2.chips');
const s2rows = t('features.s2.rows');
const s2stats = t('features.s2.stats');
---
<!-- ════════════════════════════════════════════════════
     COMPONENT: Features.astro
     ════════════════════════════════════════════════════ -->
<section class="section" style="padding-top:0">
  <div class="wrap">

    <div class="feature reveal">
      <div class="feature-copy">
        <p class="eyebrow">{t('features.s1.eyebrow')}</p>
        <h3>{t('features.s1.headline')}</h3>
        <p class="lead">{t('features.s1.lead')}</p>
        <div class="chip-row">
          {s1chips.map((c: string) => <span class="chip">{c}</span>)}
        </div>
        <a class="flink" href={implHref}>{t('features.s1.pageLink')}</a>
        <!-- Optional cross-link to the sister practice. -->
        <div class="sister" set:html={t('features.s1.sister')}></div>
      </div>
      <div class="feature-art dark">
        <div class="widget-head">
          <span class="widget-label">{t('features.s1.widgetLabel')}</span>
          <span class="badge-sample">{t('features.s1.badge')}</span>
        </div>
        <p class="widget-sub">{t('features.s1.sub')}</p>
        <div class="brow">
          <div class="brow-top"><span class="brow-name"><b>{s1rows[0].n}</b>{s1rows[0].name}</span><span class="st done">{s1rows[0].st}</span></div>
          <div class="bar"><i style="--w:100%;--c:var(--good)"></i></div>
        </div>
        <div class="brow">
          <div class="brow-top"><span class="brow-name"><b>{s1rows[1].n}</b>{s1rows[1].name}</span><span class="st done">{s1rows[1].st}</span></div>
          <div class="bar"><i style="--w:100%;--c:var(--good)"></i></div>
        </div>
        <div class="brow">
          <div class="brow-top"><span class="brow-name"><b>{s1rows[2].n}</b>{s1rows[2].name}</span><span class="st doing">{s1rows[2].st}</span></div>
          <div class="bar"><i style="--w:62%;--c:#6E89FF"></i></div>
        </div>
        <div class="brow">
          <div class="brow-top"><span class="brow-name"><b>{s1rows[3].n}</b>{s1rows[3].name}</span><span class="st next">{s1rows[3].st}</span></div>
          <div class="bar"><i style="--w:0%"></i></div>
        </div>
        <p class="wnote">{t('features.s1.wnote')}</p>
      </div>
    </div>

    <div class="feature flip reveal">
      <div class="feature-copy">
        <p class="eyebrow">{t('features.s2.eyebrow')}</p>
        <h3>{t('features.s2.headline')}</h3>
        <p class="lead">{t('features.s2.lead')}</p>
        <div class="chip-row">
          {s2chips.map((c: string) => <span class="chip">{c}</span>)}
        </div>
      </div>
      <div class="feature-art dark">
        <div class="widget-head">
          <span class="widget-label">{t('features.s2.widgetLabel')}</span>
          <span class="badge-sample">{t('features.s2.badge')}</span>
        </div>
        <p class="widget-sub">{t('features.s2.sub')}</p>
        <svg class="wmap" viewBox="0 0 480 76" role="img" aria-label={t('features.s2.svgAria')}>
          <line class="sync-line" x1="178" y1="28" x2="294" y2="28"/>
          <polygon points="302,28 290,22 290,34" fill="#6E89FF"/>
          <line class="sync-line" x1="302" y1="50" x2="186" y2="50"/>
          <polygon points="178,50 190,44 190,56" fill="#6E89FF"/>
          <rect class="wmap-node hub" x="24" y="16" width="150" height="46" rx="10"/>
          <text class="t" x="99" y="44" text-anchor="middle">{t('features.s2.crm')}</text>
          <rect class="wmap-node" x="306" y="16" width="150" height="46" rx="10"/>
          <text class="t" x="381" y="44" text-anchor="middle">{t('features.s2.erp')}</text>
        </svg>
        <div class="brow slim">
          <div class="brow-top"><span class="brow-name">{s2rows[0].name}</span><span class="st done">{s2rows[0].st}</span></div>
        </div>
        <div class="brow slim">
          <div class="brow-top"><span class="brow-name">{s2rows[1].name}</span><span class="st done">{s2rows[1].st}</span></div>
        </div>
        <div class="brow slim">
          <div class="brow-top"><span class="brow-name">{s2rows[2].name}</span><span class="st warn">{s2rows[2].st}</span></div>
        </div>
        <div class="brow slim">
          <div class="brow-top"><span class="brow-name">{s2rows[3].name}</span><span class="st warn">{s2rows[3].st}</span></div>
        </div>
        <div class="brow slim">
          <div class="brow-top"><span class="brow-name">{s2rows[4].name}</span><span class="st next">{s2rows[4].st}</span></div>
        </div>
        <div class="wstats">
          <div><b>{s2stats[0].b}</b><span>{s2stats[0].label}</span></div>
          <div><b>{s2stats[1].b}</b><span>{s2stats[1].label}</span></div>
          <div><b class="warn">{s2stats[2].b}</b><span>{s2stats[2].label}</span></div>
        </div>
        <p class="wnote">{t('features.s2.wnote')}</p>
      </div>
    </div>

  </div>
</section>
