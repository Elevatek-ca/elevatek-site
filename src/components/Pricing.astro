---
import { useTranslations, localizePath } from '../i18n/utils';
const lang = Astro.currentLocale;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
const plans = t('pricing.plans');
---
<!-- ════════════════════════════════════════════════════
     COMPONENT: Pricing.astro
     ════════════════════════════════════════════════════ -->
<section class="section" id="pricing">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{t('pricing.eyebrow')}</p>
      <h2>{t('pricing.headline')}</h2>
      <p class="lead">{t('pricing.lead')}</p>
    </div>
    <div class="price-grid">
      <article class="plan reveal">
        <p class="plan-tag">{plans[0].tag}</p>
        <p class="plan-name">{plans[0].name}</p>
        <p class="plan-sub">{plans[0].sub}</p>
        <ul>
          {plans[0].features.map((f: string) => <li>{f}</li>)}
        </ul>
        <a class="btn btn-ghost" href={lp('/contact?type=session')}>{plans[0].cta}</a>
      </article>
      <article class="plan featured reveal">
        <p class="plan-tag">{plans[1].tag}</p>
        <p class="plan-name">{plans[1].name}</p>
        <p class="plan-sub">{plans[1].sub}</p>
        <ul>
          {plans[1].features.map((f: string) => <li>{f}</li>)}
        </ul>
        <a class="btn btn-light" href={lp('/contact?type=hourly')}>{plans[1].cta}</a>
      </article>
      <article class="plan reveal">
        <p class="plan-tag">{plans[2].tag}</p>
        <p class="plan-name">{plans[2].name}</p>
        <p class="plan-sub">{plans[2].sub}</p>
        <ul>
          {plans[2].features.map((f: string) => <li>{f}</li>)}
        </ul>
        <a class="btn btn-ghost" href={lp('/contact?type=retainer')}>{plans[2].cta}</a>
      </article>
    </div>
    <p class="fineprint">{t('pricing.fineprint')}</p>
  </div>
</section>
