---
import { useTranslations, localizePath } from '../i18n/utils';
const lang = Astro.currentLocale;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
const proof = t('hero.proof');
const nodes = t('hero.nodes');
---
<!-- ════════════════════════════════════════════════════
     COMPONENT: Hero.astro
     ════════════════════════════════════════════════════ -->
<section class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <p class="eyebrow">{t('hero.eyebrow')}</p>
      <h1>{t('hero.headline')}</h1>
      <p class="lead">{t('hero.lead')}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={lp('/contact?type=session')}>{t('hero.ctaPrimary')}</a>
        <a class="btn btn-ghost" href="#process">{t('hero.ctaGhost')}</a>
      </div>
      <div class="proof-row">
        {proof.map((p: string) => <span>{p}</span>)}
      </div>
    </div>

    <div class="elevation">
      <svg viewBox="0 0 640 470" role="img" aria-labelledby="elev-title">
        <title id="elev-title">{t('hero.svgTitle')}</title>
        <!-- elevation gridlines -->
        <line class="gridline" x1="0" y1="408" x2="640" y2="408"/>
        <line class="gridline" x1="0" y1="344" x2="640" y2="344"/>
        <line class="gridline" x1="0" y1="278" x2="640" y2="278"/>
        <line class="gridline" x1="0" y1="210" x2="640" y2="210"/>
        <line class="gridline" x1="0" y1="140" x2="640" y2="140"/>
        <!-- topographic contours -->
        <path class="contour" d="M0,330 C140,300 260,340 400,250 S600,180 640,150"/>
        <path class="contour" d="M0,250 C160,230 300,260 460,160 S600,110 640,95"/>
        <!-- the ascent -->
        <path class="summit-line" d="M28,408 L110,408 L148,344 L238,344 L276,278 L366,278 L404,210 L494,210 L532,140 L606,140"/>
        <!-- stack nodes -->
        <g class="node"><circle cx="28" cy="408" r="6"/><text x="22" y="432">{nodes[0]}</text></g>
        <g class="node"><circle cx="148" cy="344" r="6"/><text x="142" y="368">{nodes[1]}</text></g>
        <g class="node"><circle cx="276" cy="278" r="6"/><text x="270" y="302">{nodes[2]}</text></g>
        <g class="node"><circle cx="404" cy="210" r="6"/><text x="398" y="234">{nodes[3]}</text></g>
        <g class="node"><circle cx="532" cy="140" r="6"/><text x="526" y="164">{nodes[4]}</text></g>
        <!-- summit -->
        <g class="summit-flag">
          <path d="M606,134 L598,118 L606,123 L614,118 Z"/>
          <text x="614" y="106" text-anchor="end">{t('hero.summit')}</text>
        </g>
      </svg>
      <p class="chart-caption">Λ {t('hero.caption')}</p>
    </div>
  </div>
</section>
