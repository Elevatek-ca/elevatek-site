---
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
const crmSteps = t('l2c.crmSteps');
const erpSteps = t('l2c.erpSteps');
const leaks = t('l2c.leaks');
const tools = t('l2c.tools');
---
<!-- ════════════════════════════════════════════════════
     COMPONENT: LeadToCash.astro
     ════════════════════════════════════════════════════ -->
<section class="section" id="problem">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{t('l2c.eyebrow')}</p>
      <h2>{t('l2c.headline')}</h2>
      <p class="lead">{t('l2c.lead')}</p>
    </div>
    <div class="l2c reveal">
      <div class="widget-head">
        <span class="widget-label">{t('l2c.widgetLabel')}</span>
        <span class="badge-sample">{t('l2c.badge')}</span>
      </div>
      <div class="l2c-rails">
        <div class="l2c-lane crm">
          <p class="l2c-cap" set:html={t('l2c.crmCap')}></p>
          <div class="l2c-side">
            {crmSteps.map((s: string, i: number) => (
              i === 0
                ? <span class="pill">{s}</span>
                : <span class="l2c-step"><span class="sep" aria-hidden="true">›</span><span class="pill">{s}</span></span>
            ))}
          </div>
        </div>
        <div class="l2c-seam">
          <span class="l2c-seam-chip">{t('l2c.seamChip')}</span>
        </div>
        <div class="l2c-lane erp">
          <p class="l2c-cap" set:html={t('l2c.erpCap')}></p>
          <div class="l2c-side">
            {erpSteps.map((s: string, i: number) => (
              i === 0
                ? <span class="pill">{s}</span>
                : <span class="l2c-step"><span class="sep" aria-hidden="true">›</span><span class="pill">{s}</span></span>
            ))}
          </div>
        </div>
      </div>
      <div class="l2c-leaks">
        <span class="leak start">{leaks[0]}</span>
        <span class="leak mid">{leaks[1]}</span>
        <span class="leak end">{leaks[2]}</span>
      </div>
      <div class="l2c-tools">
        {tools.map((tool: string) => <span class="chip">{tool}</span>)}
      </div>
      <p class="wnote">{t('l2c.wnote')}</p>
    </div>
  </div>
</section>
