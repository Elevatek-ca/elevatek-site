---
import Base from '../../layouts/Base.astro';
import { useTranslations, localizePath } from '../../i18n/utils';
const lang = Astro.currentLocale;
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);
---
<Base
  title={t('meta.notFound.title')}
  description={t('meta.notFound.description')}
  noindex={true}
  minimalFooter={true}
>
  <section class="lost">
    <div>
      <p class="eyebrow">{t('notFound.eyebrow')}</p>
      <h1 class="big">4<span class="peak">Λ</span>4</h1>
      <p class="lead" style="margin:18px auto 30px">{t('notFound.lead')}</p>
      <a class="btn btn-primary" href={lp('/')}>{t('notFound.cta')}</a>
    </div>
  </section>
</Base>
