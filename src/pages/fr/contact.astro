---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const roles = t('contact.form.roles');
const stack = t('contact.form.stack');
const engagement = t('contact.form.engagement');
const urgency = t('contact.form.urgency');
const langs = t('contact.form.langs');
---
<Base
  title={t('meta.contact.title')}
  description={t('meta.contact.description')}
  path="contact"
  ctaHref="#form"
>

  <!-- ════════════════════════════════════════════════════
       COMPONENT: ContactForm.astro
       Primary submit path is Netlify Forms (POST url-encoded
       to "/"); a mailto compose is the no-backend fallback.
       ════════════════════════════════════════════════════ -->
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{t('contact.hero.eyebrow')}</p>
      <h1>{t('contact.hero.headline')}</h1>
      <p class="lead">{t('contact.hero.lead')}</p>
    </div>
  </section>

  <section>
    <div class="wrap contact-grid">
      <form id="form" name="contact" method="POST" data-netlify="true" netlify-honeypot="website" novalidate>
        <input type="hidden" name="form-name" value="contact">
        <div class="fsection">
          <p class="eyebrow">{t('contact.form.s1Eyebrow')}</p>
          <div class="fchips">
            {roles.map((r: { value: string; label: string }) => (
              <label class="fchip"><input type="radio" name="role" value={r.value}><span>{r.label}</span></label>
            ))}
          </div>
        </div>

        <div class="fsection">
          <p class="eyebrow">{t('contact.form.s2Eyebrow')}</p>
          <div class="fchips">
            {stack.map((s: { value: string; label: string }) => (
              <label class="fchip"><input type="checkbox" name="stack" value={s.value}><span>{s.label}</span></label>
            ))}
          </div>
        </div>

        <div class="fsection">
          <p class="eyebrow">{t('contact.form.s3Eyebrow')}</p>
          <div class="fchips">
            {engagement.map((e: { value: string; label: string }) => (
              <label class="fchip"><input type="radio" name="engagement" value={e.value}><span>{e.label}</span></label>
            ))}
          </div>
        </div>

        <div class="fsection">
          <p class="eyebrow">{t('contact.form.s4Eyebrow')}</p>
          <div class="fchips">
            {urgency.map((u: { value: string; label: string }) => (
              <label class="fchip"><input type="radio" name="urgency" value={u.value}><span>{u.label}</span></label>
            ))}
          </div>
        </div>

        <div class="fsection">
          <p class="eyebrow">{t('contact.form.s5Eyebrow')}</p>
          <div class="frow">
            <div class="field">
              <label for="f-name">{t('contact.form.nameLabel')}</label>
              <input type="text" id="f-name" name="name" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="f-company">{t('contact.form.companyLabel')}</label>
              <input type="text" id="f-company" name="company" autocomplete="organization">
            </div>
          </div>
          <div class="field">
            <label for="f-email">{t('contact.form.emailLabel')}</label>
            <input type="email" id="f-email" name="email" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="f-msg">{t('contact.form.messageLabel')}</label>
            <textarea id="f-msg" name="message" placeholder={t('contact.form.messagePlaceholder')}></textarea>
          </div>
          <div class="fchips" role="group" aria-label={t('contact.form.langAria')}>
            {langs.map((l: { value: string; label: string }) => (
              <label class="fchip"><input type="radio" name="lang" value={l.value} checked={l.value === 'Either'}><span>{l.label}</span></label>
            ))}
          </div>
        </div>

        <!-- honeypot -->
        <div class="hp" aria-hidden="true">
          <label>{t('contact.form.hpLabel')}<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
        </div>

        <button class="btn btn-primary" type="submit">{t('contact.form.submit')}</button>
        <p class="form-error" id="form-error" role="alert">{t('contact.form.error')}</p>
        <p class="form-note">{t('contact.form.note')}</p>

        <div class="sister book">
          <p class="book-line">{t('contact.form.bookLine')} <a class="btn btn-primary book-btn" id="calendly-link" href="https://calendly.com/elevatek-consulting/intro-call">{t('contact.form.bookBtn')}</a></p>
          <p set:html={t('contact.form.bookContact')}></p>
        </div>
      </form>

      <aside class="req reveal in" aria-label={t('contact.req.aria')}>
        <div class="widget-head">
          <span class="widget-label">{t('contact.req.widgetLabel')}</span>
          <span class="badge-you">{t('contact.req.badge')}</span>
        </div>
        <div class="req-rows">
          <div class="req-row"><b>{t('contact.req.role')}</b><span id="s-role"></span></div>
          <div class="req-row"><b>{t('contact.req.stack')}</b><span id="s-stack"></span></div>
          <div class="req-row"><b>{t('contact.req.after')}</b><span id="s-engagement"></span></div>
          <div class="req-row"><b>{t('contact.req.when')}</b><span id="s-urgency"></span></div>
          <div class="req-row"><b>{t('contact.req.language')}</b><span id="s-lang">{t('contact.req.langDefault')}</span></div>
        </div>
        <p class="wnote">{t('contact.req.wnote')}</p>
      </aside>
    </div>
  </section>

  <Fragment slot="body-end">
    <script type="application/json" id="contact-i18n" set:html={JSON.stringify({ sentTitle: t('contact.form.sentTitle'), sentBody: t('contact.form.sentBody') })} />
    <script is:inline>
// ── form logic ──────────────────────────────────────────
const FORM_ENDPOINT = ''; // TODO: set Formspree/Netlify/worker URL. Empty = mailto compose.
const I18N = JSON.parse(document.getElementById('contact-i18n').textContent);

const form = document.getElementById('form');
const err = document.getElementById('form-error');

const read = () => {
  const v = n => (form.querySelector(`input[name="${n}"]:checked`) || {}).value || '';
  return {
    role: v('role'),
    stack: [...form.querySelectorAll('input[name="stack"]:checked')].map(i => i.value).join(', '),
    engagement: v('engagement'),
    urgency: v('urgency'),
    lang: v('lang'),
    name: form.querySelector('input[name="name"]').value.trim(),
    company: form.company.value.trim(),
    email: form.email.value.trim(),
    message: form.message.value.trim()
  };
};

// live summary
const sync = () => {
  const d = read();
  document.getElementById('s-role').textContent = d.role;
  document.getElementById('s-stack').textContent = d.stack;
  document.getElementById('s-engagement').textContent = d.engagement;
  document.getElementById('s-urgency').textContent = d.urgency;
  document.getElementById('s-lang').textContent = d.lang;
};
form.addEventListener('change', sync);

// ?type= preselect from homepage CTAs
const type = new URLSearchParams(location.search).get('type');
const map = { session: 'Free strategy session', hourly: 'Hourly help', retainer: 'Retainer' };
if (map[type]) {
  const input = form.querySelector(`input[name="engagement"][value="${map[type]}"]`);
  if (input) { input.checked = true; sync(); }
}

// submit
form.addEventListener('submit', async e => {
  e.preventDefault();
  if (form.website.value) return; // honeypot
  const d = read();
  const valid = d.name && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(d.email);
  err.classList.toggle('show', !valid);
  if (!valid) return;

  const lines = [
    'Role: ' + (d.role || '-'),
    'Stack: ' + (d.stack || '-'),
    'After: ' + (d.engagement || '-'),
    'When: ' + (d.urgency || '-'),
    'Language: ' + (d.lang || '-'),
    'Company: ' + (d.company || '-'),
    'Name: ' + d.name,
    'Email: ' + d.email,
    '',
    d.message
  ];

  // Netlify Forms is the primary path: POST url-encoded (including form-name and
  // the honeypot) to "/". FORM_ENDPOINT, if ever set, overrides the target. The
  // mailto compose stays as the failure fallback (catch). read()/summary/preselect
  // and the honeypot guard above are untouched.
  try {
    const res = await fetch(FORM_ENDPOINT || '/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(new FormData(form)).toString()
    });
    if (!res.ok) throw new Error();
    form.outerHTML = '<div class="sent"><h2>' + I18N.sentTitle + '</h2><p>' + I18N.sentBody + '</p></div>';
  } catch {
    const subject = 'Elevatek — ' + (d.engagement || 'inquiry') + (d.company ? ' — ' + d.company : '');
    location.href = 'mailto:info@elevatek.ca?subject=' + encodeURIComponent(subject) +
                    '&body=' + encodeURIComponent(lines.join('\n'));
  }
});

// ── Calendly popup ──────────────────────────────────────
// Lazy: no Calendly assets touch the page until the first click. The link's
// href is the real Calendly URL, so it still works with JS disabled.
const calendlyLink = document.getElementById('calendly-link');
let calendlyReady = false;
if (calendlyLink) {
  calendlyLink.addEventListener('click', e => {
    e.preventDefault();
    // single source of truth: the popup uses the link's own href (same as the JS-off fallback)
    const openPopup = () => { if (window.Calendly) Calendly.initPopupWidget({ url: calendlyLink.href }); };
    if (calendlyReady) { openPopup(); return; } // assets already injected
    calendlyReady = true;
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = 'https://assets.calendly.com/assets/external/widget.css';
    document.head.appendChild(css);
    const js = document.createElement('script');
    js.src = 'https://assets.calendly.com/assets/external/widget.js';
    js.onload = openPopup;
    document.body.appendChild(js);
  });
}
    </script>
  </Fragment>
</Base>

<style>
  /* booking panel — two lines, small-button link */
  .book{display:flex;flex-direction:column;gap:10px}
  .book p{margin:0}
  .book-line{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .book .book-btn{padding:.5em 1.05em;font-size:.9rem}
</style>
