---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/utils';
const t = useTranslations(Astro.currentLocale);
const sections = t('terms.sections');
---
<Base
  title={t('meta.terms.title')}
  description={t('meta.terms.description')}
  path="terms"
  noindex={true}
  minimalFooter={true}
>
  <section class="page-hero"><div class="wrap">
    <p class="eyebrow">{t('legal.eyebrow')}</p>
    <h1>{t('terms.h1')}</h1>
  </div></section>
  <div class="wrap"><div class="page">
    <!-- INTERNAL: counsel review pending before launch. Confirm subprocessor names,
         data residency, and cookie/analytics status. Remove this comment once a
         lawyer has signed off. -->
    <p class="updated">{t('legal.updated')}</p>

    <p>{t('terms.intro')}</p>

    {sections.map((s: { title: string; body: string }) => (
      <>
        <h2>{s.title}</h2>
        <p>{s.body}</p>
      </>
    ))}
  </div></div>
</Base>
