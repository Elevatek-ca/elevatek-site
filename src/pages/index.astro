---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LogoBand from '../components/LogoBand.astro';
import LeadToCash from '../components/LeadToCash.astro';
import Services from '../components/Services.astro';
import Features from '../components/Features.astro';
import Process from '../components/Process.astro';
import Calculator from '../components/Calculator.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Closer from '../components/Closer.astro';
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);
const homeUrl = lang === 'fr' ? 'https://elevatek.ca/fr/' : 'https://elevatek.ca/';

// JSON-LD is injected via set:html so its leading HTML comment survives the build
// (Astro strips comments inside named slots otherwise). Canonical + Open Graph come
// from Base props; description + inLanguage are localized.
// Service catalog reuses the localized service names so schema mirrors visible copy.
const offerNames = [
  t('features.s1.eyebrow'),
  t('features.s2.eyebrow'),
  ...t('services.items').map((s: { title: string }) => s.title),
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://elevatek.ca/#organization',
  name: 'Elevatek',
  legalName: 'Elevatek Consulting Inc.',
  url: homeUrl,
  logo: 'https://elevatek.ca/apple-touch-icon.png',
  image: 'https://elevatek.ca/og.png',
  email: 'info@elevatek.ca',
  telephone: '+1-514-961-8625',
  serviceType: 'Salesforce consulting and implementation',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2355 Guenette Street',
    addressLocality: 'Val-David',
    addressRegion: 'QC',
    postalCode: 'J0T 2N0',
    addressCountry: 'CA',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    telephone: '+1-514-961-8625',
    email: 'info@elevatek.ca',
    areaServed: ['North America', 'South America', 'Europe'],
    availableLanguage: ['en', 'fr'],
  },
  knowsLanguage: ['en', 'fr'],
  areaServed: ['North America', 'South America', 'Europe'],
  knowsAbout: [
    'Salesforce', 'Salesforce implementation', 'Salesforce integration',
    'CRM', 'Revenue Operations', 'Salesforce Data Cloud', 'Agentforce',
    'HubSpot', 'Marketing Cloud', 'business and technology alignment',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Salesforce consulting services',
    itemListElement: offerNames.map((n: string) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: n, serviceType: 'Salesforce consulting' },
    })),
  },
  inLanguage: lang === 'fr' ? 'fr-CA' : 'en-CA',
  description: t('meta.home.jsonldDescription'),
};
const structuredData = `<!-- Structured data: ProfessionalService + service catalog (entity clarity for AI answer engines). TODO: add sameAs (LinkedIn / AppExchange / Clutch) once profiles are live; priceRange omitted by choice. -->
<script type="application/ld+json">${JSON.stringify(ld)}</script>`;
---
<Base
  title={t('meta.home.title')}
  description={t('meta.home.description')}
  ogTitle={t('meta.home.ogTitle')}
  ogDescription={t('meta.home.ogDescription')}
  path=""
  home={true}
>
  <Fragment slot="head-end" set:html={structuredData} />

  <Hero />
  <LogoBand />
  <LeadToCash />
  <Services />
  <Features />
  <Process />
  <Calculator />
  <Pricing />
  <Testimonials />
  <Faq />
  <Closer />
</Base>
