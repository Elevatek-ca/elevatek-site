---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
const shareList = t('privacy.shareList');
---
<Base
  title={t('meta.privacy.title')}
  description={t('meta.privacy.description')}
  path="privacy"
  noindex={true}
  minimalFooter={true}
>
  <section class="page-hero"><div class="wrap">
    <p class="eyebrow">{t('legal.eyebrow')}</p>
    <h1>{t('privacy.h1')}</h1>
  </div></section>
  <div class="wrap"><div class="page">
    <!-- INTERNAL: counsel review pending before launch. Confirm subprocessor names,
         data residency, and cookie/analytics status. Remove this comment once a
         lawyer has signed off. -->
    <p class="updated">{t('legal.updated')}</p>

    <p>{t('privacy.intro')}</p>

    <h2>{t('privacy.whoTitle')}</h2>
    <p set:html={t('privacy.whoBody')}></p>

    <h2>{t('privacy.collectTitle')}</h2>
    <p set:html={t('privacy.collectGive')}></p>
    <!-- TODO: name the form provider and analytics tool here once chosen -->
    <p set:html={t('privacy.collectAuto')}></p>

    <h2>{t('privacy.whyTitle')}</h2>
    <p>{t('privacy.whyBody')}</p>

    <h2>{t('privacy.shareTitle')}</h2>
    <p>{t('privacy.shareIntro')}</p>
    <ul>
      {shareList.map((li: string) => <li set:html={li}></li>)}
    </ul>
    <!-- TODO: confirm the full subprocessor list before launch — Netlify (hosting + forms),
         the email/newsletter provider once chosen, Calendly, and Google (Analytics) — and link each one's terms. -->

    <h2>{t('privacy.retainTitle')}</h2>
    <p>{t('privacy.retainBody')}</p>

    <h2>{t('privacy.whereTitle')}</h2>
    <p>{t('privacy.whereBody')}</p>
    <!-- TODO: confirm each provider's data-residency / processing region (Netlify, Calendly,
         Google, and the email provider) and state it here once verified. -->

    <h2>{t('privacy.rightsTitle')}</h2>
    <p set:html={t('privacy.rightsBody')}></p>

    <h2>{t('privacy.cookiesTitle')}</h2>
    <p>{t('privacy.cookiesBody')}</p>

    <h2>{t('privacy.changesTitle')}</h2>
    <p>{t('privacy.changesBody')}</p>

    <h2>{t('privacy.contactTitle')}</h2>
    <p set:html={t('privacy.contactBody')}></p>
  </div></div>
</Base>
