---
import '../styles/global.css';
import { useTranslations, localizePath } from '../i18n/utils';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /**
   * Locale-agnostic path for this page, used to build the per-locale canonical
   * and the hreflang alternates. '' = home, 'contact' = /contact. Omit on pages
   * that should carry no canonical/hreflang (none currently).
   */
  path?: string;
  /** Open Graph type; defaults to "website". */
  ogType?: string;
  /** OG/Twitter title; defaults to the page title. */
  ogTitle?: string;
  /** OG/Twitter description; defaults to the meta description. */
  ogDescription?: string;
  /** Home page uses in-page anchors (#services); inner pages link back to /#services. */
  home?: boolean;
  /** "Let's talk" button target. Contact page overrides to the in-page #form. */
  ctaHref?: string;
  /** Legal + 404 pages use the slim footer. */
  minimalFooter?: boolean;
}

const {
  title,
  description,
  noindex = false,
  path,
  ogType = 'website',
  ogTitle,
  ogDescription,
  home = false,
  ctaHref,
  minimalFooter = false,
} = Astro.props;

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);
const lp = (p: string) => localizePath(p, lang);

const socialTitle = ogTitle ?? title;
const socialDesc = ogDescription ?? description;

// Per-page locale alternates — the SINGLE source of truth for both the hreflang
// tags and the language switcher, so the two can never disagree. Derived from the
// locale-agnostic `path` ('' = home, 'contact', 'privacy', 'terms', '404').
const SITE = 'https://elevatek.ca';
const enPath = path !== undefined ? (path ? `/${path}` : '/') : undefined;
const frPath = path !== undefined ? (path ? `/fr/${path}` : '/fr/') : undefined;
const enUrl = enPath !== undefined ? SITE + enPath : undefined;
const frUrl = frPath !== undefined ? SITE + frPath : undefined;
// hreflang + canonical: indexable pages only. The switcher renders on every page.
const showAlternates = !noindex && path !== undefined;
const canonical = showAlternates ? (lang === 'fr' ? frUrl : enUrl) : undefined;

// Header language toggle: the OTHER locale's equivalent of this page. Endonym labels
// (a French page offers "English"; an English page offers "Français"). Reuses the
// enPath/frPath above — one alternate-URL source for header, footer, and hreflang.
const otherPath = lang === 'fr' ? enPath : frPath;
const otherLangCode = lang === 'fr' ? 'en' : 'fr';
const otherShort = lang === 'fr' ? 'EN' : 'FR';
const otherFull = lang === 'fr' ? 'English' : 'Français';
const otherAria = lang === 'fr' ? 'English version' : 'Version française';

// "Let's talk" target: contact page overrides to #form, otherwise the locale's /contact.
const cta = ctaHref ?? lp('/contact');
// Anchor prefix: empty on the home page (same-page scroll), the locale home elsewhere.
const a = home ? '' : lp('/');
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
{canonical && <link rel="canonical" href={canonical} />}
{showAlternates && (
  <>
    <link rel="alternate" hreflang="en-CA" href={enUrl} />
    <link rel="alternate" hreflang="fr-CA" href={frUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
  </>
)}
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<!-- Open Graph / Twitter — emitted on every page; pages pass their own values. -->
<meta property="og:site_name" content="Elevatek">
<meta property="og:type" content={ogType}>
<meta property="og:title" content={socialTitle}>
{socialDesc && <meta property="og:description" content={socialDesc} />}
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'}>
{showAlternates && <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_CA' : 'fr_CA'} />}
<meta property="og:image" content="https://elevatek.ca/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={socialTitle}>
{socialDesc && <meta name="twitter:description" content={socialDesc} />}
<slot name="head" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<slot name="head-end" />
</head>
<body>
<a class="skip" href="#main">{t('nav.skip')}</a>

<header class="site-head">
  <div class="wrap">
    <a class="wordmark" href={lp('/')}>ELEV<span class="peak">Λ</span>TEK</a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label={t('nav.menu')}>
      <span></span><span></span><span></span>
    </button>
    <nav class="main-nav" id="nav">
      <a href={`${a}#services`}>{t('nav.services')}</a>
      <a href={`${a}#process`}>{t('nav.process')}</a>
      <a href={`${a}#pricing`}>{t('nav.pricing')}</a>
      <a href={`${a}#clients`}>{t('nav.proof')}</a>
      <a href={`${a}#faq`}>{t('nav.faq')}</a>
      {home && <Fragment set:html={`<!-- TODO: swap mailto for your Calendly / booking link -->`} />}
      {otherPath && (
        <a class="lang-toggle" hreflang={otherLangCode} href={otherPath} aria-label={otherAria}>
          <span class="lt-short">{otherShort}</span><span class="lt-full">{otherFull}</span>
        </a>
      )}
      <a class="btn btn-primary" href={cta}>{t('nav.cta')}</a>
    </nav>
  </div>
</header>

<main id="main">
  <slot />
</main>

{minimalFooter ? (
  <footer class="site-foot">
    <div class="wrap">
      <div class="foot-base" style="border-top:0;padding-top:0">
        <span>© <span id="year">2026</span> {t('footer.copyright')}</span>
        <span><a href={lp('/privacy')}>{t('footer.privacy')}</a> · <a href={lp('/terms')}>{t('footer.terms')}</a> · <a href={lp('/contact')}>{t('footer.contactLink')}</a> · <button type="button" class="cookie-prefs" data-consent="reopen">{t('footer.cookiePrefs')}</button>{enPath && frPath && (<Fragment> · <a class="foot-lang" hreflang="en" href={enPath} aria-current={lang !== 'fr' ? 'true' : undefined}>English</a> · <a class="foot-lang" hreflang="fr" href={frPath} aria-current={lang === 'fr' ? 'true' : undefined}>Français</a></Fragment>)}</span>
        <span>{t('footer.builtIn')}</span>
      </div>
    </div>
  </footer>
) : (
  <footer class="site-foot" id="contact">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <a class="wordmark" href={lp('/')}>ELEV<span class="peak">Λ</span>TEK</a>
          <p class="foot-blurb">{t('footer.blurb')}</p>
        </div>
        <div>
          <h4>{t('footer.exploreTitle')}</h4>
          <ul>
            <li><a href={`${a}#services`}>{t('nav.services')}</a></li>
            <li><a href={`${a}#process`}>{t('nav.process')}</a></li>
            <li><a href={`${a}#pricing`}>{t('nav.pricing')}</a></li>
            <li><a href={`${a}#faq`}>{t('nav.faq')}</a></li>
            <li><a href={lp('/contact')}>{t('footer.contactLink')}</a></li>
          </ul>
        </div>
        <div>
          <h4>{t('footer.contactTitle')}</h4>
          <ul>
            <li><a href="mailto:info@elevatek.ca">info@elevatek.ca</a></li>
            <li><a href="tel:+15149618625">+1 (514) 961-8625</a></li>
          </ul>
        </div>
        <div>
          <h4>{t('footer.newsletterTitle')}</h4>
          {home && <Fragment set:html={`<!-- Newsletter form: wire \`action\` to your provider (the current site already has one running). -->`} />}
          <form class="news-form" name="newsletter" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="newsletter">
            <p class="hp" aria-hidden="true"><label>{t('footer.news.hpLabel')}<input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
            <input type="email" name="email" placeholder={t('footer.news.placeholder')} required aria-label={t('footer.news.placeholder')}>
            <button class="btn btn-primary" type="submit">{t('footer.news.button')}</button>
          </form>
          <p class="news-note">{t('footer.news.note')}</p>
        </div>
      </div>
      <div class="foot-base">
        <span>© <span id="year">2026</span> {t('footer.copyright')}</span>
        <span><a href={lp('/privacy')}>{t('footer.privacy')}</a> · <a href={lp('/terms')}>{t('footer.terms')}</a> · <button type="button" class="cookie-prefs" data-consent="reopen">{t('footer.cookiePrefs')}</button>{enPath && frPath && (<Fragment> · <a class="foot-lang" hreflang="en" href={enPath} aria-current={lang !== 'fr' ? 'true' : undefined}>English</a> · <a class="foot-lang" hreflang="fr" href={frPath} aria-current={lang === 'fr' ? 'true' : undefined}>Français</a></Fragment>)}</span>
        <span>{t('footer.builtIn')}</span>
      </div>
    </div>
  </footer>
)}

<!-- Cookie consent — gates GA4 (Law 25: consent before non-essential cookies). -->
<aside class="consent" id="consent" role="dialog" aria-labelledby="consent-title" aria-describedby="consent-body" hidden>
  <div class="consent-card">
    <p class="consent-label">{t('consent.label')}</p>
    <p class="consent-title" id="consent-title">{t('consent.title')}</p>
    <p class="consent-body" id="consent-body">{t('consent.bodyBefore')}<a href={lp('/privacy')}>{t('consent.privacyLink')}</a>{t('consent.bodyAfter')}</p>
    <div class="consent-actions">
      <button type="button" class="btn btn-primary" data-consent="accept">{t('consent.accept')}</button>
      <button type="button" class="btn btn-light" data-consent="decline">{t('consent.decline')}</button>
    </div>
    <div class="consent-customise">
      <button type="button" class="consent-more" data-consent="customise" aria-expanded="false" aria-controls="consent-panel">{t('consent.customise')}</button>
    </div>
    <div class="consent-panel" id="consent-panel" hidden>
      <label class="consent-toggle">
        <span><b>{t('consent.analyticsTitle')}</b><span class="consent-toggle-sub">{t('consent.analyticsSub')}</span></span>
        <input type="checkbox" id="consent-analytics">
      </label>
      <button type="button" class="btn btn-primary" data-consent="save">{t('consent.save')}</button>
    </div>
  </div>
</aside>

<script is:inline src="/app.js"></script>
<script define:vars={{ NEWS: { success: t('footer.news.success'), error: t('footer.news.error') } }}>
// Newsletter -> Netlify Forms. Static markup (data-netlify + form-name) is what
// Netlify detects at deploy; this posts url-encoded (incl. form-name + honeypot)
// to "/". Present only where the full footer renders; guarded for the others.
(() => {
  const nf = document.querySelector('.news-form');
  if (!nf) return;
  nf.addEventListener('submit', async e => {
    e.preventDefault();
    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(nf)).toString()
      });
      if (!res.ok) throw new Error();
      nf.outerHTML = "<p class='news-note'>" + NEWS.success + "</p>";
    } catch {
      let err = nf.parentElement.querySelector('.news-err');
      if (!err) { err = document.createElement('p'); err.className = 'news-note news-err'; err.style.color = '#B4400E'; nf.after(err); }
      err.textContent = NEWS.error;
    }
  });
})();
</script>
<script is:inline>
// Cookie consent + GA4 gating (Google Consent Mode v2). GA4 is injected ONLY after
// the visitor accepts analytics — never on page load. Before consent and on decline
// there are zero GA cookies and zero googletagmanager/google-analytics requests.
(() => {
  const KEY = 'elevatek-consent';            // persistent choice: 'accepted' | 'declined'
  const DISMISS_KEY = 'elevatek-consent-dismissed'; // session-only dismiss (records no choice)
  const GA_ID = 'G-2J6WPHDXZQ';
  const banner = document.getElementById('consent');
  if (!banner) return;
  const panel = document.getElementById('consent-panel');
  const toggle = document.getElementById('consent-analytics');
  const moreBtn = banner.querySelector('[data-consent="customise"]');
  let gaLoaded = false;

  const read = () => { try { return localStorage.getItem(KEY); } catch (e) { return null; } };
  const save = (v) => { try { localStorage.setItem(KEY, v); } catch (e) {} };
  // Session-only dismiss (Esc / ask-me-later): sessionStorage, never the consent key.
  const dismissedThisSession = () => { try { return sessionStorage.getItem(DISMISS_KEY) === '1'; } catch (e) { return false; } };
  const markDismissed = () => { try { sessionStorage.setItem(DISMISS_KEY, '1'); } catch (e) {} };
  let lastTrigger = null; // element that opened the banner, for focus return

  function loadGA() {
    if (gaLoaded) return; gaLoaded = true;
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    window.gtag = gtag;
    // Consent Mode v2: all denied by default, only analytics granted on consent.
    gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
    gtag('consent', 'update', { analytics_storage: 'granted' });
    gtag('js', new Date());
    gtag('config', GA_ID);
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
    document.head.appendChild(s);
  }

  function closePanel() { if (panel) panel.hidden = true; if (moreBtn) moreBtn.setAttribute('aria-expanded', 'false'); }
  function returnFocus() {
    // banner is about to hide; if focus sits inside it, move somewhere sane
    if (!banner.contains(document.activeElement)) return;
    if (lastTrigger && lastTrigger.isConnected) lastTrigger.focus();
    else if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
  }
  function showBanner(trigger) { lastTrigger = trigger || null; banner.hidden = false; closePanel(); if (toggle) toggle.checked = (read() === 'accepted'); }
  function decide(choice) { save(choice); if (choice === 'accepted') loadGA(); returnFocus(); banner.hidden = true; closePanel(); }
  // Esc / ask-me-later: hide for this session only — record NO choice, write nothing
  // to the persistent consent key, and leave GA off (consent stays default-denied).
  function dismiss() { markDismissed(); returnFocus(); banner.hidden = true; closePanel(); }

  // First paint: honour a stored choice; a session-only dismiss suppresses the banner
  // for this session but records no consent, so it returns on the next visit.
  const saved = read();
  if (saved === 'accepted') loadGA();
  else if (saved === 'declined') { /* persisted refusal: stay off, no banner */ }
  else if (dismissedThisSession()) { /* dismissed this session: GA stays default-denied */ }
  else showBanner();

  document.addEventListener('click', (e) => {
    const el = e.target.closest('[data-consent]'); if (!el) return;
    const action = el.getAttribute('data-consent');
    if (action === 'accept') decide('accepted');
    else if (action === 'decline') decide('declined');
    else if (action === 'save') decide(toggle && toggle.checked ? 'accepted' : 'declined');
    else if (action === 'customise') {
      if (!panel) return;
      const opening = panel.hidden;
      panel.hidden = !opening;
      if (moreBtn) moreBtn.setAttribute('aria-expanded', String(opening));
      if (toggle) toggle.checked = (read() === 'accepted');
    } else if (action === 'reopen') {
      e.preventDefault();
      showBanner(el);
      const accept = banner.querySelector('[data-consent="accept"]');
      if (accept) accept.focus();
    }
  });

  // Esc dismisses the banner (privacy-protective; in addition to the visible
  // buttons, not a replacement). If the Customise panel is open, Esc steps back to
  // the banner first; otherwise it dismisses for this session only.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || banner.hidden) return;
    if (panel && !panel.hidden) {
      closePanel();
      if (moreBtn) moreBtn.focus();
    } else {
      dismiss();
    }
  });
})();
</script>
<slot name="body-end" />
</body>
</html>
